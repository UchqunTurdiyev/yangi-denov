# Saytning to'liq manzili (Telegram webhook va havolalar uchun)
SITE_URL=https://yangi-denov-wine.vercel.app/

# Telegram bot: lidlar shu chatga yuboriladi (bir nechta chat — vergul bilan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bot webhook'ini himoyalovchi ixtiyoriy uzun maxfiy so'z (faqat harf, raqam, _ va -)
TELEGRAM_WEBHOOK_SECRET=
# Ixtiyoriy: shaxsiy chatda ham sotuv kirita oladigan foydalanuvchilar ID si (vergul bilan)
TELEGRAM_ADMIN_IDS=

# Ixtiyoriy: «Sotildi» havolalarini imzolash kaliti (bo'lmasa bot tokenidan olinadi)
SALE_LINK_SECRET=

# CRM: egasi bergan havola to'liq holda (?key=... bilan)
CRM_LEAD_URL=

# Meta (Facebook/Instagram) Pixel va Conversions API
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Events Manager > Test events dagi kod (sinov paytida; keyin o'chiring)
META_TEST_EVENT_CODE=
# Sotuv summasi Meta'ga qaysi valyutada boradi (standart USD; so'm Markaziy bank kursi bo'yicha aylantiriladi)
META_CURRENCY=USD
# Kurs olinmasa ishlatiladigan zaxira kurs (1 USD = ? so'm)
USD_RATE=
# CRM sotuvlarni /api/meta/purchase ga yuborishi uchun kalit
META_PURCHASE_KEY=
